# The API alone (no other workspace packages). Its dependencies are pinned by
# api-package-lock.json, made from apps/api/package.json without the workspace-only
# devDependency (see CLAUDE.md "Server" to refresh it after changing the API's dependencies).

FROM node:22-bookworm-slim AS build
# better-sqlite3 builds from source when no prebuilt binary fits.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app/apps/api
COPY apps/api/package.json ./
COPY infra/docker/api-package-lock.json ./package-lock.json
RUN npm pkg delete "devDependencies.@noted/crypto" && npm ci --no-audit --no-fund
COPY apps/api/tsconfig.json ./
COPY apps/api/src ./src
RUN npx tsc && npm prune --omit=dev

FROM node:22-bookworm-slim
ENV NODE_ENV=production TZ=Europe/Warsaw
WORKDIR /app/apps/api
COPY --from=build /app/apps/api/package.json ./
COPY --from=build /app/apps/api/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./dist
# Data (database, nightly backups) lives in the volume mounted at ./data (root-owned from the
# earlier image, so the server runs as root like before).
EXPOSE 3000 3001
CMD ["node", "dist/index.js"]
